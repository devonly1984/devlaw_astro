---
import HeroImage from "@/assets/hero-bg.jpg";
import { Image } from "astro:assets";
import { Button } from "@/components/ui/button";
---

<section class="md:pt-10">
  <div class="relative z-40">
    <div class="absolute left-0 top-0 h-full w-full bg-black opacity-70">
    </div>
    <div
      class="container flex h-screen flex-col items-start justify-center"
    >
      <div class="z-40 mx-auto max-w-150 text-center">
        <h1
          class="text-600 font-900 lg:text-[4rem] mb-2 leading-[1.3] text-white"
        >
          Relax In <span class="text-primary"> Luxury</span>
        </h1>
        <p class="mb-4 text-white md:text-200">
          Experience the ultimate retreat at our hotel, where elegance
          meets comfort.
        </p>
        <Button className="font-600 md:text-100">
          <a href="/rooms">Book Your Stay</a>
        </Button>
      </div>
      <Image
        src={HeroImage}
        alt="Hero Image"
        class={"absolute left-0 h-full w-full object-cover -z-10"}
      />
    </div>
  </div>
</section>
