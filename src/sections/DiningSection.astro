---
import DiningCard from "@/components/cards/DiningCard.astro";
import { diningListing } from "@/lib/dining";
import DiningImg from "@/assets/dining.jpg";
import { Image } from "astro:assets";
import { Button } from "@/components/ui/button";
---

<section class="bg-muted mt-28">
  <div class="container py-16">
    <div class="lg:grid lg:grid-cols-2 lg:items-center lg:gap-12">
      <!--First Column -->
      <div class="mb-8 lg:mb-0">
        <h2 class="text-500 md:text-600 mb-1 font-600">
          Exquisite Dining Experience
        </h2>
        <p class="text-muted-foreground text-lg">
          Our restaurants offer a culinary journey featuring local and
          international cuisines prepared by award-winning chefs.
        </p>
        <ul class="mt-6 space-y-4">
          {
            diningListing.map((item) => (
              <DiningCard
                name={item.name}
                description={item.description}
              />
            ))
          }
        </ul>
        <a href="rooms">
          <Button size="lg" className="mt-8">View Rooms</Button>
        </a>
      </div>
      <!--Second Column -->
      <Image
        src={DiningImg}
        alt="Dining Image"
        class="h-full rounded-lg object-cover"
      />
    </div>
  </div>
</section>
