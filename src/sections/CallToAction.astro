---
import { Button } from "@/components/ui/button";
---

<section class="mt-28 bg-blue-900 text-white">
  <div class="container py-10 text-center">
    <h2 class="text-500 md:text-600 font-bold mb-1">
      Ready to Experience Luxury?
    </h2>
    <p class="max-w-md mt-4 mx-auto">
      Book your stay at StayLite Hotel today and enjoy an unforgettable
      experience.
    </p>
    <a href="rooms">
      <Button className="mt-8" size="lg" >
        Book Your Stay Now
      </Button>
    </a>
  </div>
</section>
