---
import { categories, type Categories } from "@/lib/categories";
import CategoryCard from "@/components/cards/CategoryCard.astro";
---

<section class="pt-28">
  <div class="container">
    <div class="max-w-[600px] mx-auto text-center mb-8">
      <h2 class="mb-1 text-500 font-600 md:text-600">Experience Luxury</h2>
      <p class="md:text-lg text-muted-foreground">
        Our rooms and suites are designed to provide you with the ultimate
        comfort and luxury experience. From our Deluxe Rooms to our
        Executive Suites, we have the perfect accommodation for you.
      </p>
    </div>
    <div class="md:grid md:grid-cols-2 md:gap-4 lg:grid-cols-3">
      {
        categories.map((category: Categories) => (
          <CategoryCard
            name={category.name}
            image={category.image}
            url={category.href}
          />
        ))
      }
    </div>
  </div>
</section>
