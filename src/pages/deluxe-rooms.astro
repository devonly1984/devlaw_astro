---
import Layout from "@/components/layouts/Layout.astro";
import { rooms } from "@/lib/constants";
import { Image } from "astro:assets";
import DeluxeImg from "@/assets/deluxe.webp";
import RoomListing from "@/components/listings/RoomListing";
const filteredRooms =
  rooms.filter((room) => room.category === "deluxe-suite") || [];
---

<Layout title="Deluxe Rooms">
  <div class="relative z-40">
    <div class="absolute left-0 top-0 h-full w-full bg-black opacity-80">
    </div>
    <div
      class="container flex items-start justify-center flex-col h-[70vh]"
    >
      <div class="z-40 max-w-175 mx-auto text-white">
        <h2
          class="mb-1 text-600 font-700 leading-[1.2] md:text-800 lg:text-900"
        >
          Deluxe Rooms
        </h2>
      </div>
      <Image
        src={DeluxeImg}
        alt="Deluxe Rooms"
        class="absolute left-0 -z-10 h-full w-full object-cover"
      />
    </div>
  </div>
  <div class="container pt-28">
    <div class="md:grid md:gap-9 md:grid-cols-2 lg:grid-cols-3">
      {
        filteredRooms.map((room) => (
          <RoomListing room={room} client:load />
        ))
      }
    </div>
  </div>
</Layout>
