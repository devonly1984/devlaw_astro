---
import {
  WifiIcon,
  UtensilsIcon,
  Dumbbell,
  WavesLadder,
} from "lucide-react";

const { icon, name, description } = Astro.props;
---

<div
  class="flex flex-col items-center justify-center rounded-lg border p-4 text-center"
>
  <div
    class="bg-primary flex size-12 items-center justify-center rounded-full"
  >
    {
      icon === "wifi" ? (
        <WifiIcon className="size-6 text-white" />
      ) : icon === "utensils" ? (
        <UtensilsIcon className="size-6 text-white" />
      ) : icon === "dumbbell" ? (
        <Dumbbell className="size-6 text-white" />
      ) : icon === "waves-ladder" ? (
        <WavesLadder className="size-6 text-white" />
      ) : null
    }
  </div>
  <h3 class="mb-4 text-lg font-bold">{name}</h3>
  <p class="text-muted-foreground ">{description}</p>
</div>
