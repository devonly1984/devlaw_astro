---
import type { Room } from '@/lib/types';
import { CameraIcon, HotelIcon, RulerIcon } from 'lucide-react';

interface Props {
    room:Room
}
const {room} = Astro.props;
---
<div class="mb-8 text-center">
      <h1 class="text-400 font-600 mb-4">{room.name}</h1>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {
          room.features.map((feature) => (
            <div class="flex items-center justify-center gap-2">
              {feature.icon === "bed" && (
                <HotelIcon className="text-primary" />
              )}
              {feature.icon === "ruler" && (
                <RulerIcon className="text-primary" />
              )}
              {feature.icon === "camera" && (
                <CameraIcon className="text-primary" />
              )}
              <p>
                {feature.name}: <strong>{feature.value}</strong>
              </p>
            </div>
          ))
        }
      </div>
    </div>